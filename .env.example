# ============================================
# Bsale ↔ Claro Shop Sync — Variables de Entorno
# ============================================

# Entorno
NODE_ENV=production

# ── Base de Datos PostgreSQL ──
DB_HOST=postgres
DB_PORT=5432
DB_USER=bcsync
DB_PASSWORD=cambia_esta_password_segura
DB_NAME=bsale_claroshop

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Bsale API ──
# Token de acceso (OAuth2). Se renueva automáticamente.
BSALE_ACCESS_TOKEN=tu_access_token_bsale
# Para renovación automática (si aplica):
BSALE_CLIENT_ID=
BSALE_CLIENT_SECRET=
BSALE_BASE_URL=https://api.bsale.io/v1

# ── Claro Shop / T1 API ──
# API Key formato: t1-xxxxxxx...
CLAROSHOP_API_KEY=t1-tu_api_key
CLAROSHOP_BASE_URL=https://api.t1.com

# ── Seguridad ──
JWT_SECRET=genera_un_secret_largo_y_aleatorio_aqui
ADMIN_PASSWORD=admin_seguro
WEBHOOK_SECRET=wh_secret_para_verificar_firma

# ── Sincronización ──
SYNC_INTERVAL_MINUTES=15

# ── Opcional: Notificaciones ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
